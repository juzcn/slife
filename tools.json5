{
  // ═══════════════════════════════════════════════════════════════════════
  //  tools.json5 — the tool system's whole configuration: one section per
  //  category, plus the `tool_load` knob.  Every entry carries the same two
  //  policy flags, siblings of each other:
  //    enabled:  false = off.  A builtin tool is then never registered (no row
  //              at all); for plugin / job / skill the catalog row reads
  //              `disabled`; for mcp / rest-api the server is not connected.
  //    autoload: true = born `loaded`: injected from session start, and never
  //              evicted (by default only the whitelist is).
  //  An entry is optional — a tool with none keeps its defaults.
  //  Unloaded is not unavailable: `tool_search` finds every row, and
  //  `func-tool-load` puts one into the injected set from that turn onward.
  //  The section order is for reading, not a contract.
  // ═══════════════════════════════════════════════════════════════════════

  // ── builtin ────────────────────────────────────────────────────────────
  // The tools slife ships as Python modules in `slife/tools/` — category
  // `builtin`, the developer's half of the `system` family.  An entry is needed
  // only to change a default, and `enabled: false` is the hard off switch: the
  // tool is never registered, so it has no catalog row and never appears in
  // `tool_search`.
  //   builtin: [
  //     { name: "install_python_package", enabled: false },
  //     { name: "execute_shell", autoload: true }        // always injected
  //   ]
  builtin: [
    {
      name: "install_python_package",
      enabled: false
    }
  ],

  // ── plugin ─────────────────────────────────────────────────────────────
  // The built-in plugins' OWN tools — category `plugin`, the other half of the
  // `system` family: memdb's `turn_search`, the gateway's `mcp_set`, wechat's
  // `wechat_login`, job-coding's `job-write`…  Bare names; the catalog records
  // the exposing plugin as the row's `source`.
  // A plugin always registers its tool set, so `enabled: false` marks the ROW
  // `disabled` (kept out of the injected set) instead of unregistering it.
  // A JOB is not here: a job is the user's own code — see `job` below.
  //   plugin: [
  //     { name: "turn_search", autoload: true },
  //     { name: "wechat_login", enabled: false }
  //   ]
  plugin: [],

  // ── mcp ────────────────────────────────────────────────────────────────
  // External MCP servers — category `mcp`, family `external` — keyed by server
  // name.  A server's tools reach the model as `{server}__{tool}`, born
  // `unloaded` unless the SERVER carries `autoload: true`, which covers its
  // whole tool set (an external tool's name is unknown until it connects).
  // `enabled: false` = the server is not connected.  Its rows are KEPT and
  // read `disabled` (a state of its own — distinct from `error`, which means
  // the server is on but down), so re-enabling restores a tool set that still
  // remembers what was loaded.  Only a server REMOVED from here loses its
  // rows, and a server that was never connected has none to begin with.
  mcp: {
    servers: {
      filesystem: {
        command: "npx",
        args: [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "."
        ],
        description: "Local filesystem operations — read, write, list, and search files within allowed directories.",
        enabled: false
      },
      serper: {
        command: "npx",
        args: [
          "-y",
          "serper-search-scrape-mcp-server"
        ],
        env: {
          SERPER_API_KEY: "${SERPER_API_KEY}"
        },
        description: "Google web search via Serper — search the web and scrape result pages."
      },
      fetch: {
        command: "uvx",
        args: [
          "--with",
          "mcp>=1.0,<1.29",
          "mcp-server-fetch"
        ],
        description: "Fetch and convert web pages to markdown. Pins mcp<1.29 for McpError compatibility."
      },
      "tavily-mcp": {
        command: "npx",
        args: [
          "-y",
          "tavily-mcp@latest"
        ],
        env: {
          TAVILY_API_KEY: "${TAVILY_API_KEY}"
        },
        description: "Tavily AI-optimized web search — designed for LLM agents, returns clean structured results."
      },
      "duckduckgo-search": {
        command: "uvx",
        autoload: true,
        args: [
          "--with",
          "duckduckgo-mcp-server[browser]",
          "duckduckgo-mcp-server",
          "--fetch-backend",
          "auto",
          "--search-backend",
          "auto"
        ],
        description: "DuckDuckGo search MCP server — web search and content extraction via DuckDuckGo."
      },
      "amap-maps": {
        command: "npx",
        args: [
          "-y",
          "@amap/amap-maps-mcp-server"
        ],
        description: "高德地图官方 MCP Server，提供地理编码、逆地理编码、IP定位、天气查询、骑行/步行/驾车/公交路径规划、距离测量、关键词/周边/详情POI搜索、专属地图、输入提示、搜索提示、矩形区域交通态势、路径信息、距离测量等多种地图和位置服务。免费，需要申请 Web服务 API Key。",
        env: {
          AMAP_MAPS_API_KEY: "${AMAP_MAPS_API_KEY}"
        }
      },
      "iflow-mcp": {
        command: "uvx",
        args: [
          "--from",
          "iflow-mcp-mcp-claude-code",
          "claudecode"
        ],
        os_paths: true,
        description: "MCP implementation of Claude Code capabilities - allows Claude to directly execute instructions for modifying and improving project files",
        source: {
          type: "pypi",
          url: "https://pypi.org/project/iflow-mcp_mcp-claude-code/",
          description: "PyPI package for Claude Code MCP server",
          fetched_at: "2026-07-23T01:42:26.885197+00:00"
        }
      },
      "file-search": {
        command: "npx",
        args: [
          "-y",
          "file-search-mcp"
        ],
        description: "Blazingly fast MCP server for searching files and content in large codebases — uses ripgrep (100x faster than grep), fuzzy find, and tree view. Tools: search_files, search_content, fuzzy_find, tree.",
        source: {
          type: "npm",
          url: "https://github.com/elad12390/file-search-mcp",
          description: "npm package for fast file search in large codebases",
          fetched_at: "2026-07-23T02:12:23.593046+00:00"
        }
      },
      playwright: {
        command: "npx",
        args: [
          "-y",
          "@playwright/mcp@latest",
          "--headless"
        ],
        description: "Playwright MCP server (official Microsoft) — headless browser automation via accessibility snapshots. Supports navigation, clicks, typing, screenshots, form filling, file uploads, and JavaScript execution.",
        source: {
          type: "npm",
          url: "https://www.npmjs.com/package/@playwright/mcp",
          version: "latest",
          description: "Official Playwright MCP server from Microsoft",
          fetched_at: "2026-08-02T00:00:00.000000+00:00"
        }
      },
      context7: {
        command: "npx",
        args: [
          "-y",
          "@upstash/context7-mcp"
        ],
        description: "Context7 MCP server (Upstash) — up-to-date library/framework API docs to eliminate LLM hallucinations. Resolution-based lookups for any version or commit (Unpkg-compatible projects only).",
        env: {
          CONTEXT7_API_KEY: "${CONTEXT7_API_KEY}"
        },
        source: {
          type: "npm",
          url: "https://www.npmjs.com/package/@upstash/context7-mcp",
          version: "latest",
          description: "Context7 MCP server from Upstash",
          fetched_at: "2026-08-01T23:30:38.777971+00:00"
        }
      },
      "chrome-devtools": {
        command: "npx",
        args: [
          "-y",
          "chrome-devtools-mcp@latest",
          "--no-usage-statistics"
        ],
        description: "Chrome DevTools MCP (official Google) — control and inspect real Chrome browser with performance profiling, network inspection, console access, DOM manipulation, and screenshots.",
        source: {
          type: "npm",
          url: "https://github.com/ChromeDevTools/chrome-devtools-mcp",
          version: "latest",
          description: "Chrome DevTools for coding agents - official Google project",
          fetched_at: "2026-08-01T23:41:47.240842+00:00"
        }
      },
      citecheck: {
        command: "npx",
        args: [
          "-y",
          "@jhlee0619/citecheck"
        ],
        description: "citecheck MCP server — automatically validate and fix references in academic papers. Extracts references from .tex/.md/.docx/.txt/.bib, validates against databases, and fixes inconsistencies. Supports arXiv/DOI/DBLP/ACL/custom APIs.",
        source: {
          type: "npm",
          url: "https://github.com/jhlee0619/citecheck",
          version: "latest",
          description: "MCP server for automatic reference repair in scholarly manuscripts (MIT)",
          fetched_at: "2026-08-01T23:51:06.761712+00:00"
        }
      },
      "mcp-pandoc": {
        command: "uvx",
        args: [
          "mcp-pandoc"
        ],
        description: "mcp-pandoc document format converter — use Pandoc to convert between Markdown/HTML/PDF/DOCX/RST/LaTeX/EPUB/TXT/IPYNB and more.",
        source: {
          type: "pypi",
          url: "https://github.com/vivekVells/mcp-pandoc",
          version: "latest",
          description: "Pandoc document conversion MCP server (official MCP servers project)",
          fetched_at: "2026-08-01T23:52:45.022542+00:00"
        }
      },
      markitdown: {
        command: "uvx",
        args: [
          "markitdown-mcp"
        ],
        description: "MarkItDown MCP server (Microsoft) — convert various file formats (PDF, DOCX, PPTX, XLSX, images via OCR, audio transcription, HTML, CSV, JSON, XML, ZIP) to Markdown.",
        source: {
          type: "pypi",
          url: "https://github.com/microsoft/markitdown",
          version: "0.0.1a4",
          description: "Microsoft MarkItDown MCP server for document-to-markdown conversion",
          fetched_at: "2026-08-01T23:56:15.694479+00:00"
        }
      },
      "office-word-mcp": {
        command: "uvx",
        args: [
          "--from",
          "office-word-mcp-server",
          "word_mcp_server"
        ],
        description: "Office-Word-MCP server — create/read/edit Microsoft Word documents. Supports document management (create, merge, convert to PDF), content creation (headings, paragraphs, tables, images, page breaks), formatting (font, alignment, spacing), and comments.",
        source: {
          type: "pypi",
          url: "https://github.com/GongRzhe/Office-Word-MCP-Server",
          version: "latest",
          description: "MCP server for creating/editing Word documents",
          fetched_at: "2026-08-02T00:00:39.614231+00:00"
        }
      },
      "excel-mcp": {
        command: "npx",
        args: [
          "--yes",
          "@negokaz/excel-mcp-server"
        ],
        description: "Excel MCP server — read/write MS Excel files. Supports reading/writing text values and formulas, creating worksheets/tables, copying worksheets, formatting cells (Windows: live editing + screenshots). Supports .xlsx/.xlsm/.xltx/.xltm. Free and open source.",
        env: {
          EXCEL_MCP_PAGING_CELLS_LIMIT: "4000"
        },
        source: {
          type: "npm",
          url: "https://github.com/negokaz/excel-mcp-server",
          version: "latest",
          description: "MCP server for reading/writing MS Excel files",
          fetched_at: "2026-08-02T00:00:58.187765+00:00"
        }
      },
      "pdf-toolkit": {
        command: "npx",
        args: [
          "-y",
          "@aryanbv/pdf-toolkit-mcp"
        ],
        description: "PDF Toolkit MCP — 22-tool PDF suite: create PDFs from Markdown/structured data, render pages as images (for vision models to read scans), fill forms and extract values, split/merge/rotate/crop pages, add text/watermarks/annotations, extract and re-embed attachments.",
        source: {
          type: "npm",
          url: "https://github.com/aryanbv/pdf-toolkit-mcp",
          version: "latest",
          description: "Write-capable PDF toolkit MCP server (22 tools)",
          fetched_at: "2026-08-02T00:04:47.866829+00:00"
        }
      },
      sqlite: {
        command: "uvx",
        args: [
          "--with",
          "mcp>=1.0,<1.29",
          "mcp-server-sqlite"
        ],
        description: "SQLite MCP (official modelcontextprotocol/servers reference) — query and manipulate SQLite databases via natural language: create tables, CRUD operations, schema inspection, and more.",
        source: {
          type: "github",
          url: "https://github.com/modelcontextprotocol/servers/tree/main/src/sqlite",
          version: "latest",
          description: "Official SQLite MCP reference server",
          fetched_at: "2026-08-02T00:05:14.333705+00:00"
        }
      }
    }
  },

  // ── rest-api ───────────────────────────────────────────────────────────
  // An OpenAPI service run as an MCP server through mcp-openapi-proxy —
  // category `rest-api`, family `external`.  The same `enabled` / `autoload`
  // rules as `mcp` (per server).  **This section is what makes one** — an
  // entry here is a REST API, no tag needed; `rest_api_set` writes here and
  // upserts write back here.
  "rest-api": {
    github: {
      command: "uvx",
      args: [
        "mcp-openapi-proxy"
      ],
      env: {
        OPENAPI_SPEC_URL: "https://raw.githubusercontent.com/github/rest-api-description/main/descriptions/api.github.com/api.github.com.yaml",
        SERVER_URL_OVERRIDE: "https://api.github.com",
        API_KEY: "${GITHUB_TOKEN}"
      },
      description: "GitHub REST API via mcp-openapi-proxy — manage repos, issues, PRs, users, and more."
    },
    "mcp-registry": {
      command: "uvx",
      args: [
        "mcp-openapi-proxy"
      ],
      env: {
        OPENAPI_SPEC_URL: "https://registry.modelcontextprotocol.io/openapi.json",
        SERVER_URL_OVERRIDE: "https://registry.modelcontextprotocol.io"
      },
      description: "A community driven registry service for Model Context Protocol (MCP) servers. Provides APIs to list/search MCP servers, view server details, versions, and server.json metadata."
    }
  },

  // ── skill ──────────────────────────────────────────────────────────────
  // Skills: markdown playbooks in the skills directory.  Not tools — a row
  // exists (`type: skill`, no load state) so `tool_search` can find it, and
  // `skill_use` returns its SKILL.md.  `enabled: false` hides it from search
  // and makes `skill_use` refuse it.
  //   skill: [{ name: "job-coding", enabled: false }]
  skill: {},

  // Unified tool-system knob (DESIGNER_NOTES §8.5) — the loaded-function-tool
  // threshold the turn-boundary LRU eviction enforces.  `autoload` is NOT a
  // knob here: it is a per-entry flag, the sibling of `enabled`, written on
  // the tool itself — e.g. `builtin: [{ name: "execute_shell", autoload: true }]`
  // or a server entry (`autoload: true` = every tool of that server).  An
  // autoloaded tool is born `loaded` and never evicted.

  // ── cli ────────────────────────────────────────────────────────────────
  // Command-line tools the agent may run — a reference card rather than an LLM
  // tool: `cli_list` enumerates them and `execute_shell` runs the command.
  cli: {
    "yt-dlp": {
      command: "yt-dlp",
      description: "yt-dlp is a powerful command-line video downloader supporting 1000+ sites including YouTube, Twitter/X, Bilibili, TikTok, etc. Common usage: yt-dlp <URL> to download best quality; yt-dlp -f \"bestvideo+bestaudio\" --merge-output-format mp4 <URL> for best quality merged MP4; yt-dlp --list-formats <URL> to list available formats; yt-dlp -f <format_id> <URL> for specific format. Supports cookies, subtitles, playlists, and more.",
      install: "uv pip install yt-dlp"
    },
    npm: {
      command: "npm",
      description: "Node Package Manager — install, manage, and publish Node.js packages. Common subcommands: npm install <pkg> — install a package; npm install -g <pkg> — install globally; npm init — create a package.json; npm run <script> — run a script from package.json; npm publish — publish a package; npm update — update packages; npm audit — audit dependencies; npm ls — list installed packages.",
      install: "Download from https://nodejs.org/ or use a version manager like nvm."
    },
    npx: {
      command: "npx",
      description: "Node Package Executor — run Node.js packages without installing them globally. Common usage: npx <pkg> — run a package directly; npx <pkg>@<version> — run a specific version; npx -y <pkg> — skip confirmation prompt; npx --help — show help. Used for one-off commands like npx create-react-app, npx tsx, etc.",
      install: "Comes bundled with npm (Node.js). Download from https://nodejs.org/."
    },
    uv: {
      command: "uv",
      description: "Fast Python package and project manager (replaces pip, pip-tools, poetry, etc.). Common subcommands: uv pip install <pkg> — install a Python package; uv pip sync — sync from requirements; uv venv — create a virtual environment; uv init — init a new project; uv add <pkg> — add a dependency; uv run <script> — run a script in the project venv; uv lock — generate lockfile; uv sync — sync the project environment; uv tool install <pkg> — install a CLI tool globally (like pipx).",
      install: "Install via: powershell -ExecutionPolicy ByPass -c \"irm https://astral.sh/uv/install.ps1 | iex\" (Windows) or curl -LsSf https://astral.sh/uv/install.sh | sh (macOS/Linux)."
    },
    uvx: {
      command: "uvx",
      description: "UV Package Executor — run Python-based CLI tools without installing them (like npx but for Python). Common usage: uvx <pkg> — run a Python CLI tool directly; uvx <pkg>@<version> — run a specific version; uvx <pkg> -- <args> — pass args to the tool. Examples: uvx ruff check ., uvx black file.py, uvx streamlit run app.py.",
      install: "Comes bundled with uv. Install uv first via: powershell -ExecutionPolicy ByPass -c \"irm https://astral.sh/uv/install.ps1 | iex\" (Windows)."
    },
    "browser-harness": {
      command: "browser-harness",
      description: "Direct browser control via CDP — automation, scraping, testing, screenshots. Subcommands: browser-harness <<'PY' ... PY (run Python helpers like new_tab, page_info, capture_screenshot, click_at_xy, js, etc.), browser-harness --doctor (diagnose connection), browser-harness skill (print SKILL.md), browser-harness auth login (cloud auth), browser-harness telemetry disable.",
      install: "uv tool install --python 3.12 --upgrade --force browser-harness",
      source: {
        type: "pypi",
        url: "https://pypi.org/project/browser-harness/",
        version: "0.1.5",
        description: "Official browser-harness package",
        fetched_at: "2026-07-13T00:44:43.891352+00:00"
      }
    }
  },

  // ── job ────────────────────────────────────────────────────────────────
  // Jobs — the user's OWN tools: a public function in `jobs/*.py`, exposed by
  // the job-coding plugin as `job-<function>` (category `job`, family `user`).
  // The code and its parameter schema live in the file, not here — an entry
  // only carries policy, and `enabled: false` mirrors onto the job's row.
  //   job: [{ name: "translate", autoload: true }]
  job: {},

  // ── tool_load ──────────────────────────────────────────────────────────
  // How many function tools may stay loaded.  At each turn boundary the
  // least-recently-used loaded tools are unloaded until the count fits; the
  // whitelist and anything marked `autoload` are never evicted.

  // Unified tool-system knob (DESIGNER_NOTES §8.5) — the loaded-function-tool
  // threshold the turn-boundary LRU eviction enforces.  `autoload` is NOT a
  // knob here: it is a per-entry flag, the sibling of `enabled`, written on
  // the tool itself — e.g. `builtin: [{ name: "execute_shell", autoload: true }]`
  // or a server entry (`autoload: true` = every tool of that server).  An
  // autoloaded tool is born `loaded` and never evicted.
  tool_load: {
    threshold: 100
  }
}
