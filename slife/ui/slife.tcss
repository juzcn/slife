/* ═══════════════════════════════════════════════════════════════════
   Slife TUI — Claude Code CLI style
   Dark minimal theme with warm amber accents.
   ═══════════════════════════════════════════════════════════════════ */

/* ── Screen ──────────────────────────────────────────────────── */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

/* ── Chat view (main scrollable area) ────────────────────────── */

ChatView {
    overflow-y: auto;
    padding: 0;
    scrollbar-size: 0 0;
    scrollbar-color: #30363d;
    scrollbar-color-hover: #484f58;
}

/* ── User messages — ">" style ───────────────────────────────── */

.user-message {
    margin: 1 0 0 0;
    padding: 0 1;
    color: #e6edf3;
}

.user-message > Static {
    width: 100%;
}

/* ── Assistant messages — clean, no label ────────────────────── */

.assistant-message {
    margin: 0 0 1 0;
    padding: 0 1;
    color: #e6edf3;
}

/* ── Thinking block inside assistant messages ────────────────── */

.thinking-block {
    color: #6e7681;
    text-style: italic;
    margin: 0 0 1 0;
    padding: 0 1;
}

/* ── System messages ─────────────────────────────────────────── */

.system-message {
    margin: 0 0;
    padding: 0 1;
    color: #6e7681;
    text-style: italic;
}

/* ── Tool call display ───────────────────────────────────────── */

.tool-call {
    margin: 0 1 1 2;
    padding: 0 1;
    border: solid #30363d;
    background: #161b22;
    color: #e6edf3;
    height: auto;
    min-height: 1;
    overflow: hidden;
}

/* ── Input (bottom docked) ────────────────────────────────────── */

/* HARDISSUES #1 — box is exactly border (1) + text (1) + spare (1).
   The border-top slot is occupied in BOTH focus states (colored as
   background when focused) so geometry never changes: no collapsed
   content region (text vanishing on blur) and no layout shift.
   Textual 8 does not stack same-edge docks — the StatusBar overlaps
   our bottom row, so it must stay a blank padding row. */
#user-input {
    dock: bottom;
    width: 100%;
    height: 3;
    padding: 0 1 1 1;
    background: #0d1117;
    color: #e6edf3;
    border: none;
    border-top: solid #30363d;
}

#user-input:focus {
    border: none;
    border-top: solid #0d1117;
}

#user-input > .input--placeholder {
    color: #484f58;
}

/* ── Status bar (bottom docked, below input) ─────────────────── */

StatusBar {
    dock: bottom;
    height: 1;
    background: #161b22;
    color: #6e7681;
    padding: 0 1;
    text-style: none;
}

/* ── Inline images ────────────────────────────────────────────── */
/* Halfcell size is capped to limit unique (fg,bg) color pairs.
   Each cell = one texture atlas entry in xterm.js.  Large images
   (>500 pairs) trigger xtermjs/xterm.js#4484 atlas corruption.
   Sixel bypasses this — no per-cell atlas entries.              */

.chat-image {
    overflow: hidden;
    margin: 1 0 1 0;
    padding: 0 1;
    width: 32;
    max-width: 32;
    height: auto;
    max-height: 16;
}

.chat-image-thumb {
    overflow: hidden;
    margin: 0 0 0 2;
    padding: 0;
    width: 20;
    max-width: 20;
    height: auto;
    max-height: 10;
}

.chat-image-fallback {
    margin: 0 0 0 2;
    padding: 0 1;
    height: 1;
}
