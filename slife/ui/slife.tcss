/* ═══════════════════════════════════════════════════════════════════
   Slife TUI — Claude Code CLI style
   Dark minimal theme with warm amber accents.
   ═══════════════════════════════════════════════════════════════════ */

/* ── Screen ──────────────────────────────────────────────────── */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

/* ── Chat view (main scrollable area) ────────────────────────── */

ChatView {
    overflow-y: auto;
    padding: 0;
    scrollbar-size: 0 0;
    scrollbar-color: #30363d;
    scrollbar-color-hover: #484f58;
}

/* ── User messages — ">" style ───────────────────────────────── */

.user-message {
    margin: 1 0 0 0;
    padding: 0 1;
    color: #e6edf3;
}

.user-message > Static {
    width: 100%;
}

/* ── Assistant messages — clean, no label ────────────────────── */

.assistant-message {
    margin: 0 0 1 0;
    padding: 0 1;
    color: #e6edf3;
}

/* ── Thinking block inside assistant messages ────────────────── */

.thinking-block {
    color: #6e7681;
    text-style: italic;
    margin: 0 0 1 0;
    padding: 0 1;
}

/* ── System messages ─────────────────────────────────────────── */

.system-message {
    margin: 0 0;
    padding: 0 1;
    color: #6e7681;
    text-style: italic;
}

/* ── Tool call display ─────────────────────────────────────────
   Expanded detail is scrollable and uses full width / most of the
   viewport height — long results (command output, QR login blocks)
   stay readable in screen, while max-height + the line cap in
   tool_display bound pathological output. */

.tool-call {
    margin: 0 1 1 1;
    padding: 0 1;
    border: solid #30363d;
    background: #161b22;
    color: #e6edf3;
    width: 1fr;
    height: auto;
    max-height: 60%;
    min-height: 1;
    overflow-y: auto;
    overflow-x: hidden;
}

/* ── Tool approval prompt (inline, Claude Code style) ─────────── */

.approval-prompt {
    margin: 0 1 1 2;
    padding: 0 1;
    border: solid #d29922;
    background: #161b22;
    color: #e6edf3;
    height: auto;
    min-height: 1;
}

.approval-prompt:focus {
    border: solid #f0c040;
    background: #1c2128;
}

/* ── Input (bottom docked) ────────────────────────────────────── */

/* The box has a minimum height of 3 and grows upward as the user types
   multi-line content (Shift+Enter or a multi-line paste), capped at 12
   lines.  Textual 8 does not stack same-edge docks — the StatusBar
   overlaps our bottom row, so it must stay a blank padding row. */
#user-input {
    dock: bottom;
    width: 100%;
    height: auto;
    min-height: 3;
    max-height: 12;
    padding: 0 1 1 1;
    background: #0d1117;
    color: #e6edf3;
    border: none;
    border-top: solid #30363d;
    scrollbar-size: 0 0;
}

#user-input:focus {
    border: none;
    border-top: solid #0d1117;
}

#user-input > .text-area--placeholder {
    color: #484f58;
}

/* ── Status bar (bottom docked, below input) ─────────────────── */

StatusBar {
    dock: bottom;
    height: 1;
    background: #161b22;
    color: #6e7681;
    padding: 0 1;
    text-style: none;
}

