{
  env: {
    BAIDU_API_KEY: "${BAIDU_API_KEY}"
  },
  agent: {
    max_iterations: 30,
    context_floor: 0.2,
    context_ceiling: 0.8,
    heartbeat_interval: 1800,
    cutin_enabled: true
  },
  models: {
    mode: "merge",
    providers: {
      deepseek: {
        base_url: "https://api.deepseek.com",
        api_key: "${DEEPSEEK_API_KEY}",
        api: "openai-completions",
        models: [
          {
            model: "deepseek-flash",
            name: "DeepSeek V4.1 Flash",
            reasoning: true,
            input: [
              "text",
              "image"
            ],
            context_window: 1000000,
            max_tokens: 384000,
            temperature: 0.7,
            top_p: 1.0
          }
        ]
      },
      qianfan: {
        base_url: "https://qianfan.baidubce.com/v2/tokenplan/personal",
        api_key: "${QIANFAN_API_KEY}",
        api: "openai-completions",
        models: [
          {
            model: "qianfan-code-latest",
            name: "switch by control panel",
            reasoning: true,
            input: [
              "text"
            ],
            context_window: 1000000,
            max_tokens: 384000,
            temperature: 0.7,
            top_p: 1.0
          }
        ]
      },
      scnet: {
        base_url: "https://api.scnet.cn/api/llm/v1",
        api_key: "${SCNET_TOKEN_PLAN}",
        api: "openai-completions",
        models: [
          {
            model: "DeepSeek-V4-Flash-0731",
            name: "DeepSeek V4 Flash",
            reasoning: true,
            input: [
              "text"
            ],
            context_window: 1000000,
            max_tokens: 384000,
            temperature: 0.7,
            top_p: 1.0
          },
          {
            model: "DeepSeek-V4",
            name: "DeepSeek V4 Pro",
            reasoning: true,
            input: [
              "text"
            ],
            context_window: 1000000,
            max_tokens: 384000,
            temperature: 0.7,
            top_p: 1.0
          },
          {
            model: "Kimi-K3",
            name: "Kimi K3",
            reasoning: true,
            input: [
              "text",
              "image"
            ],
            context_window: 1048576,
            max_tokens: 131072,
            compat: {
              thinking: "omit"
            }
          },
          {
            model: "Qwen3.8-Max",
            name: "Qwen3.8 Max",
            reasoning: true,
            input: [
              "text",
              "image"
            ],
            context_window: 983616,
            max_tokens: 131072
          },
          {
            model: "MiniMax-M3",
            name: "MiniMax M3",
            reasoning: true,
            input: [
              "text",
              "image"
            ],
            context_window: 1000000,
            max_tokens: 512000,
            compat: {
              thinking: "omit"
            }
          },
          {
            model: "GLM-5.2",
            name: "GLM 5.2",
            reasoning: true,
            input: [
              "text"
            ],
            context_window: 1048576,
            max_tokens: 131072,
            compat: {
              thinking: "omit"
            }
          }
        ]
      },
      bailian_personal: {
        base_url: "https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic",
        api_key: "${QWEN_TOKEN_PLAN_PERSONAL}",
        api: "anthropic-messages",
        models: [
          {
            model: "qwen3.8-max",
            name: "Qwen3.8 Max",
            reasoning: true,
            input: [
              "text",
              "image"
            ],
            context_window: 983616,
            max_tokens: 131072,
            compat: {
              thinkingFormat: "openai"
            }
          },
          {
            model: "qwen3.7-max",
            name: "Qwen3.7 Max",
            reasoning: false,
            input: [
              "text"
            ],
            context_window: 1000000,
            max_tokens: 65536
          },
          {
            model: "qwen3.7-plus",
            name: "Qwen3.7 Plus",
            reasoning: false,
            input: [
              "text",
              "image"
            ],
            context_window: 1000000,
            max_tokens: 65536
          },
          {
            model: "qwen3.6-flash",
            name: "Qwen3.6 Flash",
            reasoning: false,
            input: [
              "text",
              "image"
            ],
            context_window: 1000000,
            max_tokens: 32768
          },
          {
            model: "glm-5.2",
            name: "GLM 5.2",
            reasoning: false,
            input: [
              "text"
            ],
            context_window: 1000000,
            max_tokens: 16384
          },
          {
            model: "deepseek-v4-pro-0813",
            name: "DeepSeek V4 Pro 0813",
            reasoning: false,
            input: [
              "text"
            ],
            context_window: 1000000,
            max_tokens: 384000
          },
          {
            model: "deepseek-v4-flash-0731",
            name: "DeepSeek V4 Flash 0731",
            reasoning: false,
            input: [
              "text"
            ],
            context_window: 1000000,
            max_tokens: 393216
          }
        ]
      },
      local: {
        base_url: "http://127.0.0.1:8080/v1",
        api_key: "local",
        api: "openai-completions",
        models: [
          {
            model: "qwen3.8-27b",
            name: "Qwen3.8-27B (本地)",
            reasoning: false,
            input: [
              "text",
              "image"
            ],
            context_window: 262144,
            max_tokens: 4096,
            temperature: 0.7,
            top_p: 1.0
          }
        ]
      }
    }
  },
  media: {
    defaults: {
      image: "bailian_personal/wan2.7-image",
      video: "bailian_personal/happyhorse-1.1-t2v"
    },
    providers: {
      bailian_personal: {
        api: "dashscope-aigc",
        base_url: "https://token-plan.cn-beijing.maas.aliyuncs.com/api/v1",
        api_key: "${QWEN_TOKEN_PLAN_PERSONAL}",
        models: [
          {
            model: "wan2.7-image",
            kind: "image"
          },
          {
            model: "wan2.7-image-pro",
            kind: "image"
          },
          {
            model: "qwen-image-3.0-pro",
            kind: "image"
          },
          {
            model: "happyhorse-1.1-t2v",
            kind: "video",
            params: {
              resolution: "720P",
              ratio: "16:9",
              duration: 5
            }
          },
          {
            model: "happyhorse-1.1-i2v",
            kind: "video",
            params: {
              resolution: "720P",
              duration: 5
            }
          },
          {
            model: "happyhorse-1.1-r2v",
            kind: "video",
            params: {
              resolution: "720P",
              duration: 5
            }
          },
          {
            model: "qwen-audio-3.0-tts-plus",
            kind: "tts",
            voice: "longanhuan_v3.6"
          },
          {
            model: "qwen-audio-3.0-asr-flash",
            kind: "asr"
          }
        ]
      }
    }
  },
  active_model: "deepseek/deepseek-flash",
  job_coding_model: "bailian_personal/qwen3.6-flash",
  plugins: {
    required: [
      "memdb",
      "memfiles"
    ]
  },
  a2a: {
    broker: {
      host: "localhost",
      port: 1883
    }
  },
  subagent: {
    max_subagents: 5
  },
  embeddings: {
    providers: {
      local_embed: {
        base_url: "http://127.0.0.1:17347/v1",
        model: "bge-m3",
        api_key: "local"
      },
      siliconflow: {
        base_url: "https://api.siliconflow.cn/v1",
        model: "BAAI/bge-m3",
        api_key: "${SILICONFLOW_API_KEY}"
      }
    },
    active_model: "siliconflow",
    enabled: true
  }
}