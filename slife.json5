{
  env: {
    BAIDU_API_KEY: "${BAIDU_API_KEY}"
  },
  tools: [
    {
      name: "install_python_package",
      enabled: false
    }
  ],
  agent: {
    max_iterations: 30,
    context_floor: 0.2,
    context_ceiling: 0.8,
    tool_timeout: 60,
    heartbeat_interval: 1200
  },
  models: {
    mode: "merge",
    providers: {
      deepseek: {
        base_url: "https://api.deepseek.com",
        api_key: "${DEEPSEEK_API_KEY}",
        api: "openai-completions",
        models: [
          {
            model: "deepseek-v4-flash",
            name: "DeepSeek V4 Flash",
            reasoning: true,
            input: [
              "text"
            ],
            context_window: 1000000,
            max_tokens: 384000,
            temperature: 0.7,
            top_p: 1.0
          },
          {
            model: "deepseek-v4-pro",
            name: "DeepSeek V4 Pro",
            reasoning: true,
            input: [
              "text"
            ],
            context_window: 1000000,
            max_tokens: 384000,
            temperature: 0.7,
            top_p: 1.0
          },
          {
            model: "deepseek-v4-flash-vision-exp",
            name: "DeepSeek V4 Flash Vision Exp",
            reasoning: true,
            input: [
              "text",
              "image"
            ],
            context_window: 1000000,
            max_tokens: 384000,
            temperature: 0.7,
            top_p: 1.0
          }
        ]
      },
      scnet: {
        base_url: "https://api.scnet.cn/api/llm/v1",
        api_key: "${SCNET_TOKEN_PLAN}",
        api: "openai-completions",
        models: [
          {
            model: "DeepSeek-V4-Flash-0731",
            name: "DeepSeek V4 Flash",
            reasoning: true,
            input: [
              "text"
            ],
            context_window: 1000000,
            max_tokens: 384000,
            temperature: 0.7,
            top_p: 1.0
          },
          {
            model: "DeepSeek-V4",
            name: "DeepSeek V4 Pro",
            reasoning: true,
            input: [
              "text"
            ],
            context_window: 1000000,
            max_tokens: 384000,
            temperature: 0.7,
            top_p: 1.0
          },
          {
            model: "Kimi-K3",
            name: "Kimi K3",
            reasoning: true,
            input: [
              "text",
              "image"
            ],
            context_window: 1048576,
            max_tokens: 131072,
            compat: {
              thinking: "omit"
            }
          },
          {
            model: "Qwen3.8-Max",
            name: "Qwen3.8 Max",
            reasoning: true,
            input: [
              "text",
              "image"
            ],
            context_window: 983616,
            max_tokens: 131072
          },
          {
            model: "MiniMax-M3",
            name: "MiniMax M3",
            reasoning: true,
            input: [
              "text",
              "image"
            ],
            context_window: 1000000,
            max_tokens: 512000,
            compat: {
              thinking: "omit"
            }
          },
          {
            model: "GLM-5.2",
            name: "GLM 5.2",
            reasoning: true,
            input: [
              "text"
            ],
            context_window: 1048576,
            max_tokens: 131072,
            compat: {
              thinking: "omit"
            }
          }
        ]
      },
      bailian_personal: {
        base_url: "https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic",
        api_key: "${QWEN_TOKEN_PLAN_PERSONAL}",
        api: "anthropic-messages",
        models: [
          {
            model: "qwen3.8-max",
            name: "Qwen3.8 Max",
            reasoning: true,
            input: [
              "text",
              "image"
            ],
            context_window: 983616,
            max_tokens: 131072,
            compat: {
              thinkingFormat: "openai"
            }
          },
          {
            model: "qwen3.7-max",
            name: "Qwen3.7 Max",
            reasoning: false,
            input: [
              "text"
            ],
            context_window: 1000000,
            max_tokens: 65536
          },
          {
            model: "qwen3.7-plus",
            name: "Qwen3.7 Plus",
            reasoning: false,
            input: [
              "text",
              "image"
            ],
            context_window: 1000000,
            max_tokens: 65536
          },
          {
            model: "qwen3.6-flash",
            name: "Qwen3.6 Flash",
            reasoning: false,
            input: [
              "text",
              "image"
            ],
            context_window: 1000000,
            max_tokens: 32768
          },
          {
            model: "glm-5.2",
            name: "GLM 5.2",
            reasoning: false,
            input: [
              "text"
            ],
            context_window: 1000000,
            max_tokens: 16384
          },
          {
            model: "deepseek-v4-pro-0813",
            name: "DeepSeek V4 Pro 0813",
            reasoning: false,
            input: [
              "text"
            ],
            context_window: 163840,
            max_tokens: 32768
          },
          {
            model: "deepseek-v4-flash-0731",
            name: "DeepSeek V4 Flash 0731",
            reasoning: false,
            input: [
              "text"
            ],
            context_window: 1000000,
            max_tokens: 393216
          }
        ]
      },
      local: {
        base_url: "http://127.0.0.1:8080/v1",
        api_key: "local",
        api: "openai-completions",
        models: [
          {
            model: "qwen3.8-27b",
            name: "Qwen3.8-27B (本地)",
            reasoning: false,
            input: [
              "text",
              "image"
            ],
            context_window: 262144,
            max_tokens: 4096,
            temperature: 0.7,
            top_p: 1.0
          }
        ]
      }
    }
  },
  media: {
    defaults: {
      image: "bailian_personal/wan2.7-image",
      video: "bailian_personal/happyhorse-1.1-t2v"
    },
    providers: {
      bailian_personal: {
        api: "dashscope-aigc",
        base_url: "https://token-plan.cn-beijing.maas.aliyuncs.com/api/v1",
        api_key: "${QWEN_TOKEN_PLAN_PERSONAL}",
        models: [
          {
            model: "wan2.7-image",
            kind: "image"
          },
          {
            model: "wan2.7-image-pro",
            kind: "image"
          },
          {
            model: "qwen-image-3.0-pro",
            kind: "image"
          },
          {
            model: "happyhorse-1.1-t2v",
            kind: "video",
            params: {
              resolution: "720P",
              ratio: "16:9",
              duration: 5
            }
          },
          {
            model: "happyhorse-1.1-i2v",
            kind: "video",
            params: {
              resolution: "720P",
              duration: 5
            }
          },
          {
            model: "happyhorse-1.1-r2v",
            kind: "video",
            params: {
              resolution: "720P",
              duration: 5
            }
          },
          {
            model: "qwen-audio-3.0-tts-plus",
            kind: "tts",
            voice: "longanhuan_v3.6"
          },
          {
            model: "qwen-audio-3.0-asr-flash",
            kind: "asr"
          }
        ]
      }
    }
  },
  active_model: "scnet/DeepSeek-V4-Flash-0731",
  plugins: {
    // Required (core) plugins — a load failure aborts startup instead of
    // limping on without them (plugin contract: see server_utils docstring).
    required: ["memdb", "memfiles"],
    external: [
      { name: "mcp", module: "mcp_plugin.server" },
      // local-embed — standalone local embedding service (OpenAI-compatible
      // /v1/embeddings).  Loads the local model ONCE, shared by memdb +
      // memfiles (no double load).  Config: local_embed.json5 next to slife.json5.
      { name: "local-embed", module: "local_embed.server" },
    ],
  },
  a2a: {
    broker: {
      host: "localhost",
      port: 1883
    },
    heartbeat_interval: 15,
    heartbeat_timeout: 45,
    task_timeout: 120
  },
  subagent: {
    max_subagents: 5,
    task_timeout: 120
  },
  cli_tools: {
    "yt-dlp": {
      command: "yt-dlp",
      description: "yt-dlp is a powerful command-line video downloader supporting 1000+ sites including YouTube, Twitter/X, Bilibili, TikTok, etc. Common usage: yt-dlp <URL> to download best quality; yt-dlp -f \"bestvideo+bestaudio\" --merge-output-format mp4 <URL> for best quality merged MP4; yt-dlp --list-formats <URL> to list available formats; yt-dlp -f <format_id> <URL> for specific format. Supports cookies, subtitles, playlists, and more.",
      install: "uv pip install yt-dlp"
    },
    npm: {
      command: "npm",
      description: "Node Package Manager — install, manage, and publish Node.js packages. Common subcommands: npm install <pkg> — install a package; npm install -g <pkg> — install globally; npm init — create a package.json; npm run <script> — run a script from package.json; npm publish — publish a package; npm update — update packages; npm audit — audit dependencies; npm ls — list installed packages.",
      install: "Download from https://nodejs.org/ or use a version manager like nvm."
    },
    npx: {
      command: "npx",
      description: "Node Package Executor — run Node.js packages without installing them globally. Common usage: npx <pkg> — run a package directly; npx <pkg>@<version> — run a specific version; npx -y <pkg> — skip confirmation prompt; npx --help — show help. Used for one-off commands like npx create-react-app, npx tsx, etc.",
      install: "Comes bundled with npm (Node.js). Download from https://nodejs.org/."
    },
    uv: {
      command: "uv",
      description: "Fast Python package and project manager (replaces pip, pip-tools, poetry, etc.). Common subcommands: uv pip install <pkg> — install a Python package; uv pip sync — sync from requirements; uv venv — create a virtual environment; uv init — init a new project; uv add <pkg> — add a dependency; uv run <script> — run a script in the project venv; uv lock — generate lockfile; uv sync — sync the project environment; uv tool install <pkg> — install a CLI tool globally (like pipx).",
      install: "Install via: powershell -ExecutionPolicy ByPass -c \"irm https://astral.sh/uv/install.ps1 | iex\" (Windows) or curl -LsSf https://astral.sh/uv/install.sh | sh (macOS/Linux)."
    },
    uvx: {
      command: "uvx",
      description: "UV Package Executor — run Python-based CLI tools without installing them (like npx but for Python). Common usage: uvx <pkg> — run a Python CLI tool directly; uvx <pkg>@<version> — run a specific version; uvx <pkg> -- <args> — pass args to the tool. Examples: uvx ruff check ., uvx black file.py, uvx streamlit run app.py.",
      install: "Comes bundled with uv. Install uv first via: powershell -ExecutionPolicy ByPass -c \"irm https://astral.sh/uv/install.ps1 | iex\" (Windows)."
    },
    "browser-harness": {
      command: "browser-harness",
      description: "Direct browser control via CDP — automation, scraping, testing, screenshots. Subcommands: browser-harness <<'PY' ... PY (run Python helpers like new_tab, page_info, capture_screenshot, click_at_xy, js, etc.), browser-harness --doctor (diagnose connection), browser-harness skill (print SKILL.md), browser-harness auth login (cloud auth), browser-harness telemetry disable.",
      install: "uv tool install --python 3.12 --upgrade --force browser-harness",
      source: {
        type: "pypi",
        url: "https://pypi.org/project/browser-harness/",
        version: "0.1.5",
        description: "Official browser-harness package",
        fetched_at: "2026-07-13T00:44:43.891352+00:00"
      }
    }
  },
  // First-class embeddings — shared by memdb + memfiles.  Each provider is
  // an OpenAI-compatible endpoint (base_url + api_key); the local-embed
  // plugin (or a standalone local-embed server) serves local models here.
  // active_model is "provider/model" (or bare "provider") — configuration-
  // authoritative; the endpoint's /v1/models active flag is only a fallback.
  embeddings: {
    providers: {
      "local-embed": {
        base_url: "http://127.0.0.1:17347/v1",
        api_key: "local"
      }
    },
    active_model: "local-embed",
    enabled: true
  }
}