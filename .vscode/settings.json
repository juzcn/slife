{
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.exclude": ["**/venv/**", "**/.venv/**", "**/node_modules", "**/__pycache__", "**/.*"],
  "mypy-type-checker.enabled": false,
  "files.associations": {
    "*.yaml": "yaml",
    "*.j2": "jinja"
  },
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[jinja]": {
    "editor.wordWrap": "on"
  },
  "[log]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  }
}
